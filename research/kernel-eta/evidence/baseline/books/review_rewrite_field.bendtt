Box.arms : ∀x0 : <Box> -> *(.Q1) =
  λ{.Box: Σx0 : ∀x0 : *(.Q1) -> *(.Q1) -> <()>; λ{}}

Box : *(.Q1) =
  Σx0 : <Box> -> (Box.arms x0)

same : ∀x0 : ∀x0 : *(.Q1) -> *(.Q1) -> ∀x1 : ∀x1 : *(.Q1) -> *(.Q1) -> ∀x2 : {λx2 => (x0 x2) == λx2 => (x1 x2) : ∀x2 : *(.Q1) -> *(.Q1)} -> {(.Box, (λx3 => (x0 x3), ())) == (.Box, (λx3 => (x1 x3), ())) : Box} =
  λx0 => λx1 => λx2 => %x2 : x3, x4 => {(.Box, (λx5 => (x0 x5), ())) == (.Box, (λx5 => (x3 x5), ())) : Box}; {==}
