k : ∀x0 : ∀x0 : *(.Q1) -> *(.Q1) -> (Maybe -.Q1 -∀x1 : *(.Q1) -> *(.Q1)) =
  λx0 => (.Some, (λx1 => (x0 x1), ()))

same : ∀x0 : ∀x0 : *(.Q1) -> *(.Q1) -> {(k λx1 => (x0 x1)) == (.Some, (x0, ())) : (Maybe -.Q1 -∀x1 : *(.Q1) -> *(.Q1))} =
  λx0 => {==}

Maybe.arms : ∀-x0 : <Q0, Q1, Q2> -> ∀-x1 : *(x0) -> ∀x2 : <None, Some> -> *(x0) =
  λ-x0 => λ-x1 => λ{.None: <()>; λ{.Some: Σx2 : x1 -> <()>; λ{}}}

Maybe : ∀-x0 : <Q0, Q1, Q2> -> ∀-x1 : *(x0) -> *(x0) =
  λ-x0 => λ-x1 => Σx2 : <None, Some> -> (Maybe.arms -x0 -x1 x2)
