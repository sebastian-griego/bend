Box.arms : ∀x0 : <Box> -> *(.Q1) =
  λ{.Box: Σx0 : ∀x0 : *(.Q1) -> *(.Q1) -> <()>; λ{}}

Box : *(.Q1) =
  Σx0 : <Box> -> (Box.arms x0)

g : ∀x0 : ∀x0 : *(.Q1) -> *(.Q1) -> {(.Box, (λx1 => (x0 x1), ())) == (.Box, (λx1 => (x0 x1), ())) : Box} =
  λx0 => {==}

use : ∀x0 : ∀x0 : *(.Q1) -> *(.Q1) -> {(.Box, (λx1 => (x0 x1), ())) == (.Box, (λx1 => (x0 x1), ())) : Box} =
  λx0 => (g λx1 => (x0 x1))
